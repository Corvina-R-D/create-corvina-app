{{/*
Name of the Gateway: the generated Deployment and Service are <name>-istio, the pods carry the label
gateway.networking.k8s.io/gateway-name: <name>
*/}}
{{- define "corvina-app-charts-lib.gatewayName" -}}
{{ include "corvina-app-charts-lib.appName" . }}-gateway
{{- end }}

{{/*
Gateway API Gateway of the app host (built-in `istio` GatewayClass, generated by the istiod of the release),
the settings of the generated gateway, access logging, no proxy response headers and the optional TLS fingerprints in the access log
A single listener without hostname for the host and its subdomains, all covered by the certificate: one listener
per hostname gives each its own TLS filter chain and routes, and browsers reuse the HTTP/2 connection of a host
for another one of the same IP and certificate (e.g. managed.<appHost> after <appHost>), which then finds no route
(404 NR route_not_found). The HTTPRoutes restrict the hostnames.
Values: gateway.appHost, gateway.port, gateway.protocol, gateway.certificateSecretName, gateway.service,
  gateway.resources, gateway.autoscaling, tlsClientLogging
*/}}
{{- define "corvina-app-charts-lib.gateway" -}}
{{- $protocol := .Values.gateway.protocol | upper }}
{{- $gateway := include "corvina-app-charts-lib.gatewayName" . }}
{{- $_ := .Values.gateway.appHost | required ".gateway.appHost is required" }}
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: {{ $gateway }}
  namespace: {{ .Release.Namespace }}
  labels:
    # must match the revision of the istio-discovery release
    istio.io/rev: {{ .Release.Name }}
spec:
  gatewayClassName: istio
  infrastructure:
    parametersRef:
      group: ""
      kind: ConfigMap
      name: {{ $gateway }}-params
  listeners:
    - name: {{ $protocol | lower }}
      port: {{ .Values.gateway.port }}
      protocol: {{ $protocol }}
      {{- if eq $protocol "HTTPS" }}
      tls:
        mode: Terminate
        certificateRefs:
          - name: {{ .Values.gateway.certificateSecretName }}
            kind: Secret
      {{- end }}
      allowedRoutes:
        namespaces:
          from: Same
---
# settings of the generated gateway: istiod merges each key into the resource it names
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ $gateway }}-params
  namespace: {{ .Release.Namespace }}
data:
  service: |
    spec:
      {{- toYaml .Values.gateway.service | nindent 6 }}
  deployment: |
    spec:
      template:
        spec:
          containers:
            - name: istio-proxy
              resources:
                {{- toYaml .Values.gateway.resources | nindent 18 }}
  {{- with .Values.gateway.autoscaling }}
  horizontalPodAutoscaler: |
    spec:
      minReplicas: {{ .minReplicas }}
      maxReplicas: {{ .maxReplicas }}
      metrics:
        - type: Resource
          resource:
            name: cpu
            target:
              type: Utilization
              averageUtilization: {{ .targetCPUUtilizationPercentage }}
  {{- end }}
---
apiVersion: telemetry.istio.io/v1alpha1
kind: Telemetry
metadata:
  name: mesh-default
  namespace: {{ .Release.Namespace }}
spec:
  # enable access logging (you can see those logs in the <gateway>-istio pod)
  accessLogging:
    - providers:
      - name: envoy
---
# no proxy headers on the responses: no `server: istio-envoy` (PASS_THROUGH, with the default OVERWRITE it would be
# set again after the route removes it) nor the upstream server header, no x-envoy-* headers of the router
# (x-envoy-upstream-service-time...) nor of the Istio metadata exchange
apiVersion: networking.istio.io/v1alpha3
kind: EnvoyFilter
metadata:
  name: remove-proxy-headers
  namespace: {{ .Release.Namespace }}
spec:
  configPatches:
  - applyTo: NETWORK_FILTER
    match:
      context: GATEWAY
      listener:
        filterChain:
          filter:
            name: envoy.filters.network.http_connection_manager
    patch:
      operation: MERGE
      value:
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          server_header_transformation: PASS_THROUGH
  - applyTo: HTTP_FILTER
    match:
      context: GATEWAY
      listener:
        filterChain:
          filter:
            name: envoy.filters.network.http_connection_manager
            subFilter:
              name: envoy.filters.http.router
    patch:
      operation: MERGE
      value:
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          suppress_envoy_headers: true
  - applyTo: ROUTE_CONFIGURATION
    match:
      context: GATEWAY
    patch:
      operation: MERGE
      value:
        response_headers_to_remove:
        - server
        - x-envoy-upstream-service-time
        - x-envoy-decorator-operation
        - x-envoy-peer-metadata
        - x-envoy-peer-metadata-id
{{- if .Values.tlsClientLogging }}
---
# TLS client fingerprints for the access log (%TLS_JA4_FINGERPRINT%)
apiVersion: networking.istio.io/v1alpha3
kind: EnvoyFilter
metadata:
  name: tls-fingerprints
  namespace: {{ .Release.Namespace }}
spec:
  configPatches:
  - applyTo: LISTENER_FILTER
    match:
      context: GATEWAY
      listener:
        listenerFilter: envoy.filters.listener.tls_inspector
    patch:
      # not MERGE: before istio/istio#61835 it merges into every listener filter and mutates istiod's
      # shared default
      operation: REPLACE
      value:
        name: envoy.filters.listener.tls_inspector
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector
          initial_read_buffer_size: 512  # Istio's default
          enable_ja3_fingerprinting: true
          enable_ja4_fingerprinting: true
{{- end }}
{{- end }}
