{{- /* copy of corvina-k8s charts/corvina-common/templates/_vpa.tpl with the corvina-app-charts-lib prefix: keep them in sync */ -}}
{{/*
VerticalPodAutoscaler settings for the calling chart, as JSON. Later sources win:
built-in defaults, .Values.global.verticalAutoscaling, .Values.verticalAutoscaling, the "policy"
argument. Keys:
  enabled            render the VPA at all
  updateMode         Off | Initial | Recreate | InPlaceOrRecreate
  minAllowed         per-container floor, e.g. {cpu: 10m}
  maxAllowed         per-container ceiling, e.g. {cpu: "1"}; none by default
  containerPolicies  full containerPolicies list, replaces the "*" policy built from min/maxAllowed
*/}}
{{- define "corvina-app-charts-lib.vpa.settings" -}}
{{- $defaults := dict "enabled" false "updateMode" "Off" "minAllowed" (dict "cpu" "10m") -}}
{{- $global := (.context.Values.global | default dict).verticalAutoscaling | default dict -}}
{{- $chart := .context.Values.verticalAutoscaling | default dict -}}
{{- mergeOverwrite $defaults (deepCopy $global) (deepCopy $chart) (deepCopy (.policy | default dict)) | toJson -}}
{{- end -}}

{{/*
VerticalPodAutoscaler for one workload.

  {{ include "corvina-app-charts-lib.vpa" (dict "context" $ "workload" $workload) }}

  context   the chart's root context
  workload  a Deployment, StatefulSet, DaemonSet, CronJob or Job manifest; only apiVersion, kind and
            metadata.name/namespace are read, so a stub is enough for workloads created by an operator
  name      optional VPA name, defaults to the workload's
  policy    optional settings override for this workload, see corvina-app-charts-lib.vpa.settings
*/}}
{{- define "corvina-app-charts-lib.vpa" -}}
{{- $workload := .workload -}}
{{- if not (has $workload.kind (list "Deployment" "StatefulSet" "DaemonSet" "CronJob" "Job")) -}}
{{- fail (printf "corvina-app-charts-lib.vpa: unsupported workload kind %q" (toString $workload.kind)) -}}
{{- end -}}
{{- $settings := include "corvina-app-charts-lib.vpa.settings" . | fromJson -}}
{{- if $settings.enabled }}
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: {{ .name | default $workload.metadata.name | quote }}
  {{- with $workload.metadata.namespace }}
  namespace: {{ . | quote }}
  {{- end }}
spec:
  targetRef:
    apiVersion: {{ $workload.apiVersion | quote }}
    kind: {{ $workload.kind | quote }}
    name: {{ $workload.metadata.name | quote }}
  updatePolicy:
    updateMode: {{ $settings.updateMode | quote }}
  {{- if $settings.containerPolicies }}
  resourcePolicy:
    containerPolicies:
      {{- toYaml $settings.containerPolicies | nindent 6 }}
  {{- else if or $settings.minAllowed $settings.maxAllowed }}
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        {{- with $settings.minAllowed }}
        minAllowed:
          {{- toYaml . | nindent 10 }}
        {{- end }}
        {{- with $settings.maxAllowed }}
        maxAllowed:
          {{- toYaml . | nindent 10 }}
        {{- end }}
  {{- end }}
{{- end }}
{{- end -}}

{{/*
One VerticalPodAutoscaler per workload rendered by the given template files of the calling chart.

  {{ include "corvina-app-charts-lib.vpas" (dict "context" $ "templates" (list "deployment.yaml")) }}

  context    the chart's root context
  templates  file names under the chart's templates/ directory
  kinds      optional subset of workload kinds to cover, defaults to all five
  policy     optional settings override, see corvina-app-charts-lib.vpa.settings
*/}}
{{- define "corvina-app-charts-lib.vpas" -}}
{{- $context := .context -}}
{{- $policy := .policy -}}
{{- $kinds := .kinds | default (list "Deployment" "StatefulSet" "DaemonSet" "CronJob" "Job") -}}
{{- if (include "corvina-app-charts-lib.vpa.settings" . | fromJson).enabled -}}
{{- range $file := .templates -}}
{{- $rendered := include (print $context.Template.BasePath "/" $file) $context -}}
{{- range $document := regexSplit "(?m)^---[ \\t]*$" $rendered -1 -}}
{{- $workload := fromYaml $document -}}
{{- if hasKey $workload "Error" -}}
{{- fail (printf "corvina-app-charts-lib.vpas: cannot parse %s: %s" $file $workload.Error) -}}
{{- end -}}
{{- if has ($workload.kind | default "") $kinds -}}
{{ include "corvina-app-charts-lib.vpa" (dict "context" $context "workload" $workload "policy" $policy) }}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{/*
VerticalPodAutoscalers of an app chart (recommend only, see verticalAutoscaling): the workloads of
the given template files plus the subchart and operator workloads: postgresql, redis, the RabbitMQ
cluster and the gateway generated by istiod (<gateway>-istio).

  {{- include "corvina-app-charts-lib.appVpas" (dict "context" $ "templates" (list "app.yaml" "service.yaml")) }}
*/}}
{{- define "corvina-app-charts-lib.appVpas" -}}
{{- $ := .context -}}
{{- include "corvina-app-charts-lib.vpas" (dict "context" $ "templates" .templates "kinds" (list "Deployment" "StatefulSet" "DaemonSet" "CronJob")) }}
{{- $stubs := list (dict "kind" "StatefulSet" "name" (printf "%s-postgresql" $.Release.Name)) -}}
{{- if include "corvina-app-charts-lib.redisEnabled" $ -}}
{{- $stubs = append $stubs (dict "kind" "StatefulSet" "name" (printf "%s-redis-master" $.Release.Name)) -}}
{{- end -}}
{{- if include "corvina-app-charts-lib.rabbitmqEnabled" $ -}}
{{- $stubs = append $stubs (dict "kind" "StatefulSet" "name" (printf "%s-server" $.Values.rabbitmq.clusterName)) -}}
{{- end -}}
{{- $stubs = append $stubs (dict "kind" "Deployment" "name" (printf "%s-istio" (include "corvina-app-charts-lib.gatewayName" $))) -}}
{{- range $stubs }}
{{ include "corvina-app-charts-lib.vpa" (dict "context" $ "workload" (dict "apiVersion" "apps/v1" "kind" .kind "metadata" (dict "name" .name))) }}
{{- end }}
{{- end -}}
