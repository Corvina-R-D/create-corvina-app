{
  "name": "@corvina/nestjs-app-common-lib",
  "version": "0.1.0",
  "description": "Shared NestJS code of the Corvina apps: utils, decorators and Corvina JWT auth",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Corvina-R-D/create-corvina-app.git",
    "directory": "packages/npm/nestjs-app-common-lib"
  },
  "keywords": [
    "corvina",
    "nestjs"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "iso8601-duration": "^2.1.4",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "match-url-wildcard": "^0.0.4",
    "pino": "^10.3.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.2.0",
    "sequelize": "^6.37.0",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^5.58.0",
    "@typescript-eslint/parser": "^5.58.0",
    "eslint": "^8.33.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "29.7.0",
    "prettier": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.2.0",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "ts-jest": "29.1.2",
    "typescript": "^5.9.3"
  }
}
