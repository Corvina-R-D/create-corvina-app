{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "strict": true,
    "declarationMap": true
  },
  "include": [
    "src/**/*"
  ]
}
