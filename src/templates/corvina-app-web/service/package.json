{
  "name": "[| .Name |]-service",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true, maxRetries: process.platform === 'win32' ? 10 : 0 })\"",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "env-cmd nest start",
    "start:dev": "env-cmd nest start --watch",
    "start:debug": "env-cmd nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
[|- if .Devcontainer |]
    "test": "env-cmd -f .env.devcontainer --use-shell \"START_FEATURES=migrator.up,quit nest start && jest\"",
    "test:watch": "env-cmd -f .env.devcontainer --use-shell \"START_FEATURES=migrator.up,quit nest start && jest --watch\"",
    "test:cov": "env-cmd -f .env.devcontainer --use-shell \"START_FEATURES=migrator.up,quit nest start && jest --coverage\"",
 [|- else |]
    "test": "env-cmd --use-shell \"START_FEATURES=migrator.up,quit nest start && jest\"",
    "test:watch": "env-cmd --use-shell \"START_FEATURES=migrator.up,quit nest start && jest --watch\"",
    "test:cov": "env-cmd --use-shell \"START_FEATURES=migrator.up,quit nest start && jest --coverage\"",
 [|- end |]
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@corvina/nestjs-app-common-lib": "^1.1.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.8",
    "@redis/client": "^6.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^5.58.0",
    "@typescript-eslint/parser": "^5.58.0",
    "env-cmd": "^11.0.0",
    "eslint": "^8.33.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "multer": "^2.5.0",
    "uuid": "^11.1.1",
    "glob@>=9.0.0 <14.0.2": "^14.0.3",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.4"
  }
}
