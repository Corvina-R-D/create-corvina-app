# Use this file to run the service on your HOST machine (e.g. `npm run start:dev`)
# while postgresql[| if .RedisEnabled |]/redis[| end |][| if .RabbitEnabled |]/rabbitmq[| end |] run inside the
# service devcontainer (`devcontainer up --workspace-folder . --config .devcontainer/service/devcontainer.json`).
# Their ports are published to the same-numbered ports on localhost.
NODE_TLS_REJECT_UNAUTHORIZED=0

LOG_TO_FILE=
LOG_LEVEL=info

PG_HOST=localhost
PG_PORT=5432
PG_USER=corvina_app_[| .Name |]
PG_PASS=corvina_app_[| .Name |]
PG_DATABASE=corvina_app_[| .Name |]

[|- if .RedisEnabled |]
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
[|- end |]

[|- if .RabbitEnabled |]
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_ADMIN_PORT=15672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=password
[|- end |]

MANIFEST_ID=corvina-app-[| .Name |]
MANIFEST_BASE_URL=https://[| .Name |].corvina.mk:443
MANIFEST_BASE_URL_FE_APP=https://[| .Name |].corvina.mk:443
MANIFEST_API_VERSION=chart-1.0.0
INSTALLATION_HOSTS_WHITELIST=*
